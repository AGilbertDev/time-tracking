{
  "name": "time-tracking",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host localhost --port 8080",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "( [ -n \"$VERCEL\" ] || git submodule update --init --recursive ) && nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepare": "husky",
    "recipes:update": "git submodule update --remote --recursive && git add .recipes",
    "apply-migrations": "bun run --env-file=.env scripts/apply-migrations.ts",
    "seed": "bun run --env-file=.env scripts/seed.ts",
    "test": "vitest run",
    "setup": "bash .devcontainer/setup.sh"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@nuxt/eslint": "1.15.2",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/i18n": "^10.4.0",
    "@tanstack/vue-query": "^5.101.4",
    "@vercel/blob": "^2.6.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "eslint": "^10.4.0",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "0.5.29",
    "resend": "^6.12.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41",
    "vue-router": "^5.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@tanstack/vue-table": "8.21.3",
    "drizzle-kit": "^0.31.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
